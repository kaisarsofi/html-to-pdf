{
  "name": "@kaisarsofi/html-to-pdf",
  "version": "0.3.4",
  "description": "Zero-setup HTML to PDF in the browser. Turns any element into a real vector PDF that copies its desktop layout exactly \u2014 backgrounds, gradients, rounded corners, images, links and fonts \u2014 with selectable text and no page cut through a line, row or card. No headless browser, no server, no screenshots.",
  "keywords": [
    "pdf",
    "html-to-pdf",
    "html2pdf",
    "dom-to-pdf",
    "element-to-pdf",
    "pdf-generation",
    "client-side-pdf",
    "browser-pdf",
    "vector-pdf",
    "pagination",
    "page-break",
    "print",
    "invoice",
    "receipt",
    "report",
    "pdf-lib",
    "jspdf",
    "html2canvas",
    "puppeteer",
    "react",
    "nextjs"
  ],
  "homepage": "https://github.com/kaisarsofi-kxar/html-to-pdf#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaisarsofi-kxar/html-to-pdf.git"
  },
  "bugs": {
    "url": "https://github.com/kaisarsofi-kxar/html-to-pdf/issues"
  },
  "author": "Kaisar Sofi",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build-fonts.mjs && tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"test/**/*.test.js\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
